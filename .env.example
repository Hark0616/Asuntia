# Configuración del entorno Asuntia

# Entorno (development | staging | production)
ENVIRONMENT=development

# Base de Datos PostgreSQL
POSTGRES_USER=asuntia
POSTGRES_PASSWORD=asuntia_dev
POSTGRES_DB=asuntia_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL de conexión SQLAlchemy Async (usada por backend)
DATABASE_URL=postgresql+asyncpg://asuntia:asuntia_dev@localhost:5432/asuntia_db

# Seguridad JWT
JWT_SECRET=super_secret_jwt_key_asuntia_change_in_prod_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Configuración CORS
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Servicio de Correo / OTP (Mailpit en local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@asuntia.com
EMAILS_FROM_NAME=Asuntia Legal
