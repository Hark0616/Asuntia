# Configuración del entorno Asuntia

# Entorno (development | staging | production)
ENVIRONMENT=development

# Firma inicial del ingreso web (opcional, variable pública de compilación Vite).
# Sin valor preconfigurado, el usuario indica su firma o usa /?firma=identificador.
VITE_FIRMA_SLUG=

# Base de Datos PostgreSQL
POSTGRES_USER=asuntia
POSTGRES_PASSWORD=asuntia_dev
POSTGRES_DB=asuntia_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL de conexión SQLAlchemy Async (usada por backend)
DATABASE_URL=postgresql+asyncpg://asuntia:asuntia_dev@localhost:5432/asuntia_db

# Seguridad JWT
JWT_SECRET=super_secret_jwt_key_asuntia_change_in_prod_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Ventana compartida entre procesos, presupuestos por identidad y por IP/firma.
AUTH_WINDOW_SECONDS=900
AUTH_LOGIN_LIMIT=8
AUTH_OTP_REQUEST_LIMIT=3
AUTH_VERIFY_LIMIT=12
AUTH_RECOVERY_REQUEST_LIMIT=3
AUTH_IP_LIMIT=120
AUTH_MIN_RESPONSE_SECONDS=0.2
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=30
# En producción, usar el dominio raíz compartido, por ejemplo: .asuntia.com
COOKIE_DOMAIN=
FRONTEND_URL=http://127.0.0.1:5173

# Google Drive OAuth (crear una aplicación web en Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/storage/oauth-callback
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_TOKEN_ENCRYPTION_KEY=

# Configuración CORS
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Servicio de Correo / OTP (Mailpit en local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# none exclusivamente en local; starttls (587) o ssl (465) en producción.
SMTP_SECURITY=none
SMTP_TIMEOUT_SECONDS=5
SMTP_MAX_ATTEMPTS=2
EMAILS_FROM_EMAIL=no-reply@asuntia.com
EMAILS_FROM_NAME=Asuntia Legal
